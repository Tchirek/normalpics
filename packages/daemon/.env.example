# Worker communication
WORKER_URL=https://api.example.com
DAEMON_SECRET=replace-with-worker-daemon-secret

# Local storage
PHOTO_DIR=C:/Users/YOURNAME/Pictures/NormalPics
THUMBNAIL_DIR=C:/Users/YOURNAME/Pictures/NormalPics/.cache/thumbs

# Local image server
LOCAL_SERVER_PORT=18080

# Cloudflare Tunnel
TUNNEL_ENABLED=true
TUNNEL_PUBLIC_URL=
CLOUDFLARED_RUNNER=cloudflared
CLOUDFLARED_COMMAND=npx
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_TUNNEL_NAME=
CLOUDFLARED_QUICK_TUNNEL=false
CLOUDFLARED_LOG_LEVEL=info

# R2 S3 API credentials
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=photohost
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# LLM metadata generation
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_VISION_CAPABLE=true
LLM_MAX_TOKENS=180
LLM_PROMPT=You are labeling a private photography gallery. Return compact JSON only.
LLM_TIMEOUT_MS=30000

# Sync concurrency
SYNC_CONCURRENCY=4
PROCESS_CONCURRENCY=2
